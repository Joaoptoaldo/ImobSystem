# arquivo de exemplo de variáveis de ambiente para o projeto Django, copie este arquivo para .env e configure as variáveis de ambiente conforme necessário.

# chave secreta do Django
SECRET_KEY=django-insecure-hashkey1234567890

# modo de depuração 
DEBUG=True

# hosts permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# URL do banco de dados (opcional, se não definido, será usado o SQLite)
DATABASE_URL=