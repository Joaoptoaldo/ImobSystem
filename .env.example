# arquivo de exemplo de variáveis de ambiente para o projeto Django, copie este arquivo para .env e configure as variáveis de ambiente conforme necessário.

# chave secreta do Django
SECRET_KEY=django-insecure-hashkey1234567890

# modo de depuração 
DEBUG=True

# hosts permitidos
ALLOWED_HOSTS=localhost,127.0.0.1

# URL do banco de dados (opcional, se não definido, será usado o SQLite)
DATABASE_URL=

# configurações AWS S3 para uploads de imagens (opcionais)

# se definidas, os uploads de imagens (ImmobileImage) vão para o S3
# caso contrário, usa o armazenamento local (media/)

# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN= (opcional: ex.: seu-cloudfront.net ou seu-bucket.s3.amazonaws.com)
